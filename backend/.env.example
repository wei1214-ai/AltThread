# Backend-only secrets. NEVER ship these to the Android client.

# Garment segmentation. Free tier is fine for development.
# Leave BLANK to use a built-in mock provider (no network call, demo-friendly).
ROBOFLOW_API_KEY=

# Roboflow model id and version. Default: clothes segmentation.
ROBOFLOW_MODEL=clothes-segmentation-final/1

# Part 2 will use this for virtual try-on. The Android client must NEVER see it.
FAL_KEY=
